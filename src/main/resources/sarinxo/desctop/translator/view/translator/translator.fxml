<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="sarinxo.desctop.translator.view.translator.TranslatorMainPageController">

    <!-- Верхняя панель с выбором языков -->
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Label text="С языка:"/>
                <ComboBox fx:id="sourceLang" prefWidth="150"/>

                <Label text="На язык:"/>
                <ComboBox fx:id="targetLang" prefWidth="150"/>

                <Button fx:id="translateButton" text="Перевести" prefWidth="120"/>
            </children>
        </HBox>
    </top>

    <!-- Центральная часть: два текстовых окна -->
    <center>
        <SplitPane dividerPositions="0.5">
            <items>
                <!-- Окно для ввода текста -->
                <TextArea fx:id="inputTextArea" wrapText="true" promptText="Введите текст для перевода"/>

                <!-- Окно для результата перевода -->
                <TextArea fx:id="outputTextArea" wrapText="true" editable="false" promptText="Здесь будет перевод"/>
                <ProgressIndicator fx:id="progressIndicator" visible="false" />
            </items>
        </SplitPane>
    </center>

</BorderPane>

